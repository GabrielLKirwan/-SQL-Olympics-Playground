-- Hard Difficulty (Aim for 4–5 minutes each)
-- 5. Rolling Calculations (Window Functions)
-- Track the historical medal bloat of the Summer games specifically. For every Summer edition, calculate a rolling average of the total medals awarded globally across that specific edition and the two strictly preceding Summer editions. Return the year of the edition and the calculated rolling average, rounded to one decimal place, ordered chronologically.

select 
    edition_year
    ,round(avg(total_medals) over 
        (order by edition_year asc 
        rows between 2 preceding and current row),1) as rolling_medal_avg
from editions
    where season = 'Summer'
    order by edition_year asc



