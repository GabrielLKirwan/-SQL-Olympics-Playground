-- 6. Category Dominance (Top N)
-- Determine the single most successful discipline for every National Olympic Committee. For each country, identify the specific discipline in which they have won their highest historical total of medals. Return the country's name, the discipline's name, and the total medal count. If a country has multiple disciplines perfectly tied for their highest medal count, you must return all tied disciplines for that country.

;
select 
    country_name
    ,rank() over (partition by country_name, discipline_name order by count(medal) ) as dominant_cat
    ,discipline_name
    ,count(medal)
from nocs as n 
    join results as r   
        on n.noc = r.noc_id
    join editions as ed 
        on r.edition_id = ed.edition_id
    join events as e 
        on e.event_id = r.event_id
    join disciplines as d 
        on d.discipline_id = e.discipline_id
group by country_name, discipline_name
order by country_name, dominant_catw

