-- 5. CTEs & Window Functions (Top N per Category)

-- Determine which specific discipline has yielded the highest total number of medals for each overarching Sports Group.
-- Write a query that joins results (filtering for non-null medals), events, disciplines, and sport_groups. Group the data to count total medals per discipline_name within each sports_group_name. Use a CTE and the ROW_NUMBER() or RANK() window function partitioned by the sports group to isolate the top-performing discipline per group. Return the sports_group_name, the discipline_name, and the medal count.
with cte as (
    select 
    disc.discipline_name
    ,sg.sports_group_name
    ,count(total_medals as tm
    ,rank () over ( partition by disc.discipline_name order by count(total_medals) desc) as rank_top_medal
    from til_data_engineering.olympics.editions as ed 
        join til_data_engineering.olympics.results as res 
            on ed.edition_id = res.edition_id
        join til_data_engineering.olympics.events as ev 
            on ev.event_id = res.event_id
        join til_data_engineering.olympics.disciplines as disc
            on ev.discipline_id = disc.discipline_id
        join til_data_engineering.olympics.sport_groups as sg
            on disc.sports_group_id =sg.sports_group_id
    where total_medals is not null 
    group by disc.discipline_name,sg.sports_group_name
    )


    select
    sports_group_name
    ,discipline_name
    ,rank_top_medal
    from cte
    where rank_top_medal = 1


;









