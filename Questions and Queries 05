-- 1. String Functions & Pattern Matching

-- We need to identify athletes who share a specific naming convention. Write a query to find all athletes whose used_name contains the word "Junior" (case-insensitive). Return their full_name and used_name from the athletes table.


select 
full_name
from til_data_engineering.olympics.athletes
where full_name in  ('Junior')



;
-- 2. Date Filtering & Status

-- The marketing team wants to highlight young, active talent. Write a query to return the full_name and date_of_birth of all athletes born on or after January 1, 2000, who currently have an 'Active' status. Order the results from youngest to oldest.

select
full_name
,date_of_birth
from til_data_engineering.olympics.athletes
where date_of_birth > '2000-01-01'


;
-- 3. Basic Arithmetic & Sorting

-- How crowded were the Olympic villages? For each Olympic edition, calculate the average number of participants per country. Return the edition_year, host_city, and the result of dividing total_participants by total_countries. Round this number to the nearest whole integer and order the results from most crowded to least crowded.

select 
    edition_year
    ,host_city
    ,round(div0(total_participants,total_countries),0) as avg_part
from til_data_engineering.olympics.editions
   order by avg_part desc
    



;
