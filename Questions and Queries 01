-- 4. Filtering & Date Math

-- Identify the top 10 competitors who lived the longest lives. Return their full name and their exact age in years at the time of their death. Exclude anyone from the results who is still living or whose death date is unknown.



select 
full_name
,datediff(years,date_of_birth,date_of_death)
from til_data_engineering.olympics.athletes
where status != 'Alive' and date_of_death is not null







;

-- 5. Multi-Entity Aggregation

-- The planning committee wants to know which specific disciplines are the most medal-heavy. Identify any disciplines that have historically awarded strictly more than 500 medals. Return the discipline's name and the total medal count, sorted from the highest medal count to the lowest.

select 
d.discipline_name
,count(r.medal) as total_medal

from til_data_engineering.olympics.disciplines as d
    join til_data_engineering.olympics.events as e
        on d.discipline_id = e.discipline_id 
    join til_data_engineering.olympics.results as r 
        on r.event_id = e.event_id
group by d.discipline_name
having total_medal > 500
order by total_medal desc



;
-- 6. Cross-Referencing & Distinct Values

-- Provide an alphabetical, deduplicated list of the full names of every individual competitor who participated in any event during the 2016 edition year.




select
distinct(full_name)
from til_data_engineering.olympics.athletes as a
    join til_data_engineering.olympics.results as r 
        on a.athlete_id = r.athlete_id
    join til_data_engineering.olympics.editions as e
        on r.edition_id=e.edition_id 
where edition_year = 2016




;

-- Hard Difficulty (Aim for 4–5 minutes each)
-- 7. Cross-Seasonal Versatility

-- We want to find the rarest tier of versatile competitors: those who have successfully won at least one medal in a Summer edition AND at least one medal in a Winter edition. Return the full name of these competitors alongside the total overall number of medals they have won in their entire career.



select 
full_name
,count(medal)
from til_data_engineering.olympics.results as r 
    join til_data_engineering.olympics.editions as e
        on  r.edition_id = e.edition_id
    join til_data_engineering.olympics.athletes as a
        on a.athlete_id = r.athlete_id
where medal is not null 
group by full_name
having count(distinct season) = 2

;
