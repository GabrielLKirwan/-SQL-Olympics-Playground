-- 1. Data Retrieval & Sorting

-- We need a historical record of female competitors who have passed away. Retrieve their full names and their dates of birth, and order the final list from the oldest birth date to the youngest.


select 
    full_name
    ,sex
    ,date_of_birth
From til_data_engineering.olympics.athletes
where sex = 'Female' and status = 'Dead'
order by date_of_birth asc





;

-- 2. Pattern Matching

-- Find all National Olympic Committees where the associated country's name begins with the letter 'A' and ends with the letter 'a' (case-insensitive). Return only the country names.

select 
country_name
from til_data_engineering.olympics.nocs
where lower(left(country_name, 1)) = 'a' and lower(right(country_name,1)) = 'a'






;


-- 3. Basic Arithmetic

-- Calculate the absolute difference between the total number of historical participants and the total number of medals awarded across all editions combined. Return this as a single numerical value.


select
sum(total_participants)
,sum( total_medals)
,sum( total_participants) - sum(distinct total_medals) as difference
from til_data_engineering.olympics.editions



;

