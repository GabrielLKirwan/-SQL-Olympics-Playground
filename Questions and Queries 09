-- 7. Common Table Expressions (CTEs) & Subqueries

-- Identify the "above-average" Olympic editions. First, use a CTE to calculate the average total_participants across all editions. Then, write a main query that returns the edition_year, host_city, and total_participants for only those editions that had a higher number of participants than the historical average.

;
with q1 as (
select 
edition_year
,host_city
,total_participants
,round(avg(total_participants) over ()) as avg_participants
from til_data_engineering.olympics.editions
)

select *

from q1 
where total_participants > avg_participants


;



-- 8. Advanced: CTEs + Window Functions + Joins

-- Who was the most successful country in each Olympic edition based purely on total medals recorded in the results?
-- Write a query that uses a CTE to count the total number of medals won by each country_name (via the nocs table) per edition_year. Then, use a window function on that CTE to return only the single top medal-winning country for each edition_year, along with their medal count.

with q1 as(
select 
    nocs.country_name
    ,edition_year
    ,count(res.medal) as medal_count
from til_data_engineering.olympics.nocs 
    left join til_data_engineering.olympics.results as res 
        on nocs.noc = res.noc_id
    left join til_data_engineering.olympics.editions as eds 
        on res.edition_id = eds.edition_id
where res.medal is not null 
group by country_name,edition_year
)


select 
    country_name
    ,edition_year
    ,rank() over (partition by edition_year order by medal_count desc) as no1country
from q1 
    qualify no1country = 1
   order by edition_year desc
    
