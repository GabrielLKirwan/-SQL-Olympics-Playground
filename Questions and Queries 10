-- **8. Advanced Grouping & Tie-Breakers (Top N)**

-- > We categorize countries into different historical "eras". For every distinct era, identify the single individual competitor who has amassed the highest total number of medals while representing a country in that era.
-- > Return the name of the era, the competitor's full name, and their total medal count. If multiple competitors are perfectly tied for the highest medal count within a specific era, return all of the tied individuals for that era.

with cte as (
select 
    full_name
    ,count(medal) as total_medals
    ,country_era
from results as r 
    join athletes as a
       on a.athlete_id = r.athlete_id
    join nocs as n 
      on  n.noc = r.noc_id

group by full_name, country_era
    order by count(medal) desc
)


select 
    full_name
    ,country_era
    ,total_medals
    ,rank() over ( partition by country_era order by total_medals  desc) as rank_
from cte
qualify rank_ = 1 


;
select 
country_name
,count(r.medal)
from nocs
    join results as r 
        on nocs.noc = r.noc_id
group by country_name
having country_name = 'Canada'


